# ============================================================
# CẤU HÌNH AI CHATBOT (3-IN-1: CHITCHAT + RAG PGVECTOR + TOOLS)
# ============================================================

# 1. Chọn Provider LLM: "gemini" hoặc "openai"
LLM_PROVIDER=gemini

# 2. API Keys (Điền key bạn đang có)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Model LLM
# Với Gemini: gemini-2.5-flash hoặc gemini-1.5-flash
# Với OpenAI: gpt-4o-mini hoặc gpt-4o
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# 4. Cấu hình Embedding (tạo vector)
# "gemini" (text-embedding-004 - 768 dims)
# "openai" (text-embedding-3-small - 1536 dims)
# "local" (chạy offline miễn phí bằng sentence-transformers - 384 dims)
EMBEDDING_PROVIDER=gemini

# 5. Cấu hình Băm Chunk
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=120

# 6. Cấu hình PostgreSQL + pgvector
# Nếu dùng docker-compose.yml: docker compose up -d
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Cổng chạy ứng dụng Web
PORT=8000
